# ── agent-remote configuration ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Or run `agent-remote setup` for a guided wizard.

# Discord
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

# Infrastructure
DATABASE_URL=postgresql+asyncpg://agent_remote:agent_remote@localhost:5432/agent_remote
REDIS_URL=redis://localhost:6379/0

# Workspace — path to your projects root directory
WORKSPACE_CWD=

# Enabled providers (comma-separated: claude,codex,cursor,antigravity)
ENABLED_PROVIDERS=claude

# Encryption key for stored secrets (auto-generated by setup wizard)
ENCRYPTION_KEY=

# Provider API keys (optional — Claude Code uses CLI auth; set only if you use API key mode)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250929
CLAUDE_CODE_BINARY_PATH=
CLAUDE_EFFORT=
OPENAI_API_KEY=
CODEX_MODEL=gpt-5.4
CODEX_BINARY_PATH=
CODEX_HOME=
